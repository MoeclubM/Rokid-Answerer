/* ===================================================
   Rokid AR 秒出答案页面样式表 (480x352 AR Display)
   =================================================== */

.stage-capture,
.stage-solving,
.stage-answer,
.stage-error {
  width: 480px;
  height: 352px;
  box-sizing: border-box;
  background-color: var(--color-background);
}

.stage-capture {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.capture-count {
  font-size: 64px;
  line-height: 80px;
  font-weight: 500;
  color: var(--color-primary);
  text-align: center;
}

.provider-info {
  margin-top: 14px;
  font-size: 15px;
  line-height: 22px;
  color: var(--color-primary-60);
  text-align: center;
}

.stage-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-preview {
  width: 360px;
  height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: var(--radius-md);
  margin-bottom: 10px;
  background-color: #000000;
}

.preview-img {
  width: 360px;
  height: 220px;
}

.stage-solving {
  display: flex;
  flex-direction: column;
  padding: 12px 16px;
  height: 352px;
  box-sizing: border-box;
}

.solving-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
  height: 16px;
  flex-shrink: 0;
}

.progress-track {
  position: relative;
  width: 280px;
  height: 1px;
  background-color: var(--color-primary-24, rgba(64, 255, 94, 0.24));
}

.progress-dot {
  position: absolute;
  top: -2px;
  width: 5px;
  height: 5px;
  border-radius: 9999px;
  background-color: var(--color-primary);
  box-shadow: 0 0 6px var(--color-primary-60);
}

.thinking-scroll {
  flex-grow: 1;
  height: 300px;
  width: 100%;
}

.thinking-text {
  font-size: 13px;
  line-height: 19px;
  color: var(--color-primary-60);
  font-family: monospace;
}

.solving-sub {
  margin-top: 12px;
  font-size: 14px;
  line-height: 20px;
  color: var(--color-primary-60);
  text-align: center;
}

.stage-answer {
  display: flex;
  flex-direction: column;
  padding: 12px 16px;
}

.answer-scroll {
  flex-grow: 1;
  height: 328px;
}

.answer-block {
  margin-bottom: 8px;
}

.answer-text {
  font-size: 16px;
  line-height: 24px;
  color: var(--color-primary-60);
}

.formula-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 4px 0;
}

.math-formula-text {
  font-size: 16px;
  line-height: 24px;
  color: var(--color-primary);
  font-weight: 500;
  font-family: monospace, sans-serif;
  letter-spacing: 0.2px;
}

.answer-text-pending {
  font-size: 16px;
  line-height: 24px;
  color: var(--color-primary-40);
}

.answer-gap {
  height: 6px;
}

.stage-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.error-msg {
  font-size: 16px;
  line-height: 24px;
  color: var(--color-primary);
  text-align: center;
}

.error-action-hint {
  margin-top: 12px;
  font-size: 13px;
  line-height: 18px;
  color: var(--color-primary-40);
  text-align: center;
}
